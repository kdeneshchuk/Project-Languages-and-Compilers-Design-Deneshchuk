(* Telly: a language that reads like a story *)
(* Course project, stage 2 *)

(* ---------- program ---------- *)

program      ::= { struct_decl } { task_decl } { statement } tell_stmt

statement    ::= const_decl | var_decl | assign | when_stmt
               | while_stmt | for_stmt | print_stmt | give_stmt

(* ---------- structures ---------- *)

struct_decl  ::= "struct" ident ":" field_decl { field_decl }
                 { task_decl } "end" "."
field_decl   ::= "once" [ "changing" ] type ident "."

(* a task declared inside a struct is a member function *)

(* ---------- tasks (functions) ---------- *)

task_decl    ::= "task" ident "(" [ param { "," param } ] ")"
                 "giving" type ":" block "end" "."
param        ::= type ident

(* ---------- statements ---------- *)

const_decl   ::= "always" builtin_type ident "is" literal "."
var_decl     ::= "once" [ "changing" ] type ident "was" expr "."
assign       ::= access "became" expr "."
when_stmt    ::= "when" expr ":" block [ "otherwise" ":" block ] "end" "."
while_stmt   ::= "while" expr ":" block "end" "."
for_stmt     ::= "for" ident "from" expr "to" expr ":" block "end" "."
print_stmt   ::= "print" "(" ( string | expr ) ")" "."
give_stmt    ::= "give" factor "."
tell_stmt    ::= "tell" factor "."

block        ::= statement { statement }

(* ---------- types ---------- *)

type         ::= builtin_type | ident
builtin_type ::= "int" | "long" | "flag"

(* an ident used as a type names a struct *)

(* ---------- expressions ---------- *)

expr         ::= arith [ compare_op arith ]
arith        ::= term { ( "+" | "-" ) term }
term         ::= factor { "*" factor }
factor       ::= number | boolean | read_expr | make_expr
               | call_expr | access

read_expr    ::= "read" "(" ")"
make_expr    ::= "make" ident "(" expr { "," expr } ")"
call_expr    ::= ident "(" [ expr { "," expr } ] ")" [ "of" access ]
access       ::= ident { "of" ident }

(* access reads from the inside out: "x of center of c" is the field x of
   the field center of the variable c. In a call_expr, "of access" names
   the object a member function is called on: "shift(2) of p".         *)

compare_op   ::= "equals" | "differs" | "🟰" | "🚫"

literal      ::= number | boolean
boolean      ::= "yes" | "no" | "👍" | "👎"

(* ---------- lexical rules ---------- *)

ident        ::= ( letter | "_" ) { letter | digit | "_" }
number       ::= digit { digit }
string       ::= '"' { any byte except '"' and newline } '"'
letter       ::= "a" .. "z" | "A" .. "Z"
digit        ::= "0" .. "9"

(* "x" .. "y" means any single character from x to y. *)

(* ident, number, string, letter and digit are lexical rules: the lexer
   recognises them, so the parser has no function for them.             *)

(* ---------- terminals produced by the lexer ---------- *)

(* ident  : letters, digits and '_', not starting with a digit,
            and not a reserved word                                *)
(* number : decimal digits only, no sign; a letter or '_' directly
            after the digits is a lexical error (10x)              *)
(* string : starts with '"' and ends with the next '"' on the same
            line; any bytes between them, there are no escape
            sequences ("\n" is two characters); a string that is
            not closed on its line is a lexical error, reported at
            its opening '"'                                        *)

(* reserved words:
     always  once  changing  is  was  became
     when  otherwise  end  tell
     struct  task  giving  give  of  make  print  read
     while  for  from  to
     int  long  flag
     equals  differs  yes  no                                      *)

(* emoji tokens (4 bytes each in UTF-8):
     👍 F0 9F 91 8D    👎 F0 9F 91 8E
     🟰 F0 9F 9F B0    🚫 F0 9F 9A AB                              *)

(* other tokens: + - * : . ( ) ,                                   *)

(* whitespace (space, tab, carriage return, newline) separates tokens
   and is dropped; a statement may span several lines, the '.' ends it.
   there are no comments.                                          *)

(* ---------- context conditions (not expressible in EBNF) ---------- *)

(* Done by the parser (stage 1, kept):
   - a number larger than 9223372036854775807 is a lexical error;
   - a number standing alone on the right side of "is" or "was" must
     fit the type written in the same declaration
       int  : 0 .. 2147483647
       long : 0 .. 9223372036854775807
     there is no sign, so a literal is never negative;
   - "when", "while" and "for" blocks may be nested at most 100 levels
     deep (one shared counter).                                       *)

(* Done by the parser (stage 2):
   - program order: structs, then tasks, then statements, then "tell";
     a struct after a task or a statement, or a task after a statement,
     is an error at that line;
   - inside a struct the fields come first (at least one), then the
     member functions;
   - "give" may stand only inside a task or a member function, and a
     task body ends with "give" as its last statement; nothing follows
     "give" in the same block;
   - "tell" stays the last statement of the program, never inside a
     block or a task;
   - a call alone is not a statement; a string literal may stand only
     as the argument of "print"; "read" takes no arguments;
   - "read" and "print" are reserved: no variable, task, parameter,
     field or member function may be named so.                       *)

(* Done by the semantic pass (stage 2); every rule is written out in
   README.md and has a program that follows it and one that breaks it:
   - names: one declaration per scope, declared before use, shadowing
     in inner blocks; global "always" constants are visible in tasks,
     "once" variables of the top level are not;
   - types: the narrowest type of a number, "int" widens into "long",
     nothing narrows, "flag" never meets a number; the condition of
     "when" is a "flag"; overflow of a value of an expression or of
     "became";
   - tasks: the number and the types of the arguments, the type of the
     value left with "give", all signatures are known before any body
     is checked;
   - structs: a value for every field of "make", fields of known types,
     no struct inside itself, every link of an access exists, a write
     needs every link to be "once changing";
   - loops: the condition of "while" is a "flag"; both bounds of "for"
     are "int" and are checked before the loop variable exists; the
     loop variable is an "int", is not "once changing" and lives only
     in the body of its loop;
   - member functions: names looked up among parameters and locals,
     then fields, then global constants; a member function that assigns
     a field (directly or through another member function) may be
     called only on a "once changing" object.                        *)