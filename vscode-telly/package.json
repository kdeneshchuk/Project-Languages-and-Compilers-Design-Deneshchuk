{
  "name": "telly",
  "displayName": "Telly Language Support",
  "description": "Highlighting, emoji completion, snippets and compiler errors for the Telly language",
  "version": "0.1.0",
  "publisher": "kdeneshchuk",
  "engines": { "vscode": "^1.80.0" },
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [{
      "id": "telly",
      "aliases": ["Telly"],
      "extensions": [".telly"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "telly",
      "scopeName": "source.telly",
      "path": "./syntaxes/telly.tmLanguage.json"
    }],
    "snippets": [{
      "language": "telly",
      "path": "./snippets/telly.json"
    }],
    "configuration": {
      "title": "Telly",
      "properties": {
        "telly.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Run the Telly compiler while typing and underline its error."
        },
        "telly.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Python that has llvmlite installed, e.g. ~/lcd/bin/python3."
        },
        "telly.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Full path of compiler.py. Empty means compiler.py in the workspace folder."
        }
      }
    }
  }
}